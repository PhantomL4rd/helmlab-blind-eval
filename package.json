{
  "name": "helmlab-blind-eval",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "snapshot": "node scripts/snapshot-data.mjs",
    "export": "node scripts/export-cli.mjs && node scripts/generate-report.mjs",
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
